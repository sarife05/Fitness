extends layout

block content
    h1 Progress Tracker

    h2 Add / Edit Progress

    form#progressForm

        input(type="hidden" id="progressId")

        p Date
        input(type="date" id="date" required)

        p Body Weight
        input(type="number" id="bodyWeight" step="0.1" required)

        p Target Weight
        input(type="number" id="target" step="0.1")

        p Notes
        textarea(id="notes")

        br
        button(type="submit") Save

    hr

    h2 Progress History

    table(border="1" width="100%")

        thead
            tr
                th Date
                th Weight
                th Target
                th Notes
                th Actions

        tbody#progressTable

    script(src="/javascripts/progress.js")