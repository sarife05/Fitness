extends layout

block content
    h1 Workout Items

    h2 Add / Edit Item

    form#itemForm

        input(type="hidden" id="itemId")

        p Workout

        select(id="workoutId" required)
            option(value="") Select workout

        p Exercise

        select(id="exerciseId" required)
            option(value="") Select exercise

        p Sets
        input(type="number" id="sets" required)

        p Reps
        input(type="number" id="reps" required)

        p Weight
        input(type="number" step="0.1" id="weight" required)

        br
        button(type="submit") Save Item

    hr

    h2 Workout Items

    table(border="1" width="100%")
        thead
            tr
                th Exercise
                th Sets
                th Reps
                th Weight
                th Actions

        tbody#itemTable

    script(src="/javascripts/workoutItems.js")